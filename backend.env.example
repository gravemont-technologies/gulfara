# Gulfara Backend/Edge Function Environment Template
# This file is deprecated. Use `.env.example` / `.env` for local development and
# set production secrets in your provider's secret manager. Kept here for historical reference.

# Server-only secrets (if used historically). Prefer putting these values into `.env` for local dev.
# Populate values directly from your secret manager or secure vault.

# Firebase admin credentials (used by Edge functions + scripts).
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Clerk token verification (JWKS is required; API key optional).
CLERK_JWKS_URL=https://clerk.static-accounts.com/jwks
CLERK_API_KEY=optional_clerk_api_key_when_using_server_sdk

# OpenAI secrets (optional if AI features disabled).
OPENAI_API_KEY=your_openai_api_key
OPENAI_USER_MONTHLY_CAP=1000

