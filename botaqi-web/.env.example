##############################################
# Gulfara Frontend Environment Configuration #
##############################################
# Copy this file to .env and supply values.
# Only add publishable / browser-safe keys here.

# Supabase project settings (public)
VITE_SUPABASE_URL=https://your-instance.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clerk authentication (public)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# OpenAI (public usage in frontend)
VITE_OPENAI_API_KEY=your_openai_browser_key

# Application runtime
VITE_APP_BASE_URL=http://localhost:5200
