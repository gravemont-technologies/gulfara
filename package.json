{
  "name": "gulfara",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env:status": "node scripts/log-env.cjs",
    "preflight": "npm run env:status && npm run test:unit",
    "predev": "npm run env:status",
    "prebuild": "npm run env:status",
    "validate:env": "node scripts/validate-env.cjs",
    "premigrate": "npm run validate:env",
    "premigrate:users": "npm run validate:env",
    "oracle:snapshot": "tsx ../scripts/supabase-snapshot-oracle.ts",
    "oracle:validate": "node ../scripts/cloud-sql-validator.ts",
    "staging:up": "docker-compose -f ../docker-compose.staging.yml up -d",
    "replay:requests": "tsx ../scripts/replay-production-requests.ts",
    "infra:generate": "tsx ../scripts/generate-terraform.ts",
    "infra:validate": "bash ../scripts/validate-infrastructure.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "migrate": "tsx scripts/migrate-data.ts",
    "migrate:users": "tsx scripts/migrate-users.ts",
    "test:unit": "vitest run --dir tests --passWithNoTests",
    "test:integration": "vitest run --dir tests/integration --passWithNoTests",
    "test:api": "vitest run --dir tests/api --passWithNoTests",
    "test:watch": "vitest",
    "test:smoke": "playwright test --config playwright.config.ts --project=chromium --grep \"@smoke\"",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:ci": "npm run lint && npm run test:unit && npm run test:integration && npm run test:api && npm run test:smoke",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "playwright:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.0.0",
    "dotenv": "^16.0.0",
    "firebase": "^10.7.1",
    "firebase-admin": "^13.6.0",
    "jose": "^4.15.4",
    "@radix-ui/react-avatar": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-progress": "^1.0.0",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-toast": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@tanstack/react-query": "^5.51.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.15.4",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.0.0",
    "typescript-eslint": "^8.46.1",
    "pg": "^8.10.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/supertest": "^2.0.16",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "jsdom": "^27.1.0",
    "msw": "^2.6.4",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "tsx": "^4.8.1",
    "@types/dotenv": "^2.0.6"
  }
}
