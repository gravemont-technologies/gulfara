##############################################
# Gulfara Frontend Environment Configuration #
##############################################
# Copy this file to `.env` and supply publishable/browser-safe values.
# Keep private keys (Firebase Admin, OpenAI) in the local `.env` or a secret vault.

# Firebase (client/public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX
NEXT_PUBLIC_USE_FIREBASE=true
NEXT_PUBLIC_DUAL_WRITE_MODE=false

# Clerk (public)
# Clerk manages the sign-in/session UI while Firebase powers persistence and data reads.
# Keep both keys in sync so Clerk-issued identities map to Firebase records.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Edge feature flags (safe for client)
VITE_USE_EDGE_REVIEW=true
VITE_USE_EDGE_AI_PROXY=true

# Application runtime
VITE_APP_BASE_URL=http://localhost:5200

# NOTE: This template lists both public and private keys for reference.
# Copy into `.env` for local dev (commit only the template) and keep `.env` gitignored.

# Private / admin variables (server-side only)
# NODE_ENV=development

# Firebase Admin (server-side, do not commit)
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# OpenAI / API usage controls
OPENAI_API_KEY=your_openai_api_key
OPENAI_USER_MONTHLY_CAP=5.00

# Test / CI default
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173/

# Optional: Vite-friendly OpenAI key for local dev (only add if intentionally exposed)
# VITE_OPENAI_API_KEY=your_openai_browser_key

