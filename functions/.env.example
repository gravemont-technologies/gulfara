# Minimal env example for serverless deployment (Vercel/Preview)
# Use CI/Secrets to populate actual values. Do NOT commit real secrets.

# Base64-encoded Firebase service account JSON (use when running outside GCP)
# Example usage: set FIREBASE_ADMIN_KEY to base64-encoded contents of service-account.json
FIREBASE_ADMIN_KEY=

# Optional ingestion API key for `/logBlocked`
# If set, `logBlocked` will require the header `x-api-key: <LOGBLOCKED_API_KEY>`
LOGBLOCKED_API_KEY=

# If you use the Firestore emulator locally, set this to `localhost:8080`
# (only for local dev; not needed in Vercel)
FIRESTORE_EMULATOR_HOST=

# Notes:
# - In Vercel, create two project/environment secrets: `FIREBASE_ADMIN_KEY` and `LOGBLOCKED_API_KEY`.
# - `FIREBASE_ADMIN_KEY` should be the base64 of the full service account JSON file.
# - The server code will prefer `FIREBASE_ADMIN_KEY` (base64) if present, otherwise fall back to
#   the standard `GOOGLE_APPLICATION_CREDENTIALS` or built-in environment credentials.
