rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kill-switch document: readable by any service, writable only by authorized server principals
    match /kill_switch/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Ingestion: only allow authenticated clients to create documents
    match /blocked_actions/{doc} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
