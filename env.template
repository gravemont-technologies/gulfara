# Gulfara Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Firebase (Public - Safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_USE_FIREBASE=true
NEXT_PUBLIC_DUAL_WRITE_MODE=false

# Clerk (Public - Safe for browser)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Edge feature flags (safe for client)
VITE_USE_EDGE_REVIEW=true
VITE_USE_EDGE_AI_PROXY=true

# App Configuration
VITE_APP_BASE_URL=http://localhost:5200
VITE_APP_BASE_PATH=/

# Development Notes:
# - Replace placeholder values with your actual Firebase and Clerk credentials
# - For production, change VITE_APP_BASE_URL to your deployment URL
# - Set VITE_APP_BASE_PATH if the app needs to be served from a sub-path (e.g. /gulf-arabic-flashcards)
# - All VITE_ and NEXT_PUBLIC_ prefixed variables are safe for frontend use
